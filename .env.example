NODE_ENV=development
PORT=5040
DATABASE_URL=postgresql://postgres:password@localhost:5432/axonlink_admin?schema=public
ACCESS_TOKEN_SECRET=replace-with-a-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret
RESET_TOKEN_SECRET=replace-with-another-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
RESET_CODE_MINUTES=10
ADMIN_BOOTSTRAP_SECRET=replace-with-a-fourth-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5173
AXONLINK_APP_API_URL=http://localhost:5030
AXONLINK_SERVICE_SECRET=replace-with-a-shared-random-service-secret

# Production requires Resend or SMTP for reset, invitation and communication emails.
# Use EMAIL_PROVIDER=resend with a verified sender and production API key.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_FROM=

# SMTP configuration (used when EMAIL_PROVIDER=smtp).
# Without it in development, reset codes are written to the backend terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Axonlink Admin <no-reply@axonlink.ai>
